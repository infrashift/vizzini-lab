# Pinned sources for the four tools under test. build.sh clones each SRC at
# its SHA into .cache/src/<tool>, so the working checkouts are never touched.
# SRC may be a local path (relative to this repo) or a git URL.

VIZZINI_SRC=../vizzini-pr-reviewer
# b002fad: CI templates pinned to mrman v0.1.9 (bot built from b7f55f9).
VIZZINI_SHA=b002fad154a3ea2b7ab077a98e2616de2122de9e

MRMAN_SRC=../mrman
# v0.1.9: the GitHub driver retries reads on 5xx and unsent requests (PR #20).
MRMAN_SHA=v0.1.9

GARMR_SRC=../garmr-policy-agent
GARMR_SHA=bf96753b9123fc9ac667afed84eba1610d896c53

OKFW_SRC=../okf-wiki
OKFW_SHA=557c304ed5616f4d633013697328f8d7980fc389

# LiteLLM proxy image, pinned by tag and digest (v1.99.4, built 2026-09-25).
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.99.4@sha256:475f4ae80a09d769d84c92202e70502abe52a62a760c97e598261c9c8cf8244f

# .NET SDK image for Roslyn SARIF.
DOTNET_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0

# Models under test, as named in litellm/config.yaml.
MODELS="claude-sonnet-5-5 claude-opus-5-5"

# Node image for ESLint (TypeScript fixtures): 24.22.1 (2026-10-21), by digest.
NODE_IMAGE=docker.io/library/node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53

# Seeded fixtures under fixtures/, each run through every model.
FIXTURES="csharp-seeded ts-seeded"

# Postgres for LiteLLM's spend logs (ISSUE-025): 17.10 (2026-07-07), by digest.
POSTGRES_IMAGE=docker.io/library/postgres:17.10-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193

# GitLab CE and gitlab-runner for the GitLab CI template test (uat/ci-gitlab.sh), by digest.
GITLAB_CE_IMAGE=docker.io/gitlab/gitlab-ce:19.5.1-ce.0@sha256:bb79dc86267c557fd11e7feb0cd9dd506dd02e991ecdd6cae11ca7d7e5d36fc3
GITLAB_RUNNER_IMAGE=docker.io/gitlab/gitlab-runner:v19.5.1@sha256:8e049fb719162488893a9eccc48f3a05259d02f2386dfbb20f3e379a50575afd

# PR-Agent (the-pr-agent/pr-agent, Apache-2.0), the benchmark's comparison
# reviewer (uat/bench.sh, Vizzini ISSUE-022). 0.49.0 was published
# 2026-10-25; pinned by digest.
PR_AGENT_IMAGE=docker.io/pragent/pr-agent:0.49.0@sha256:10a8893d5e081be1a5ae825843d9fc14f8e8d59d8a4f61d67c1775415156079f

# Static linters for the benchmark's round 2 (uat/bench-lint.sh), by digest,
# each published at least two weeks before use.
GOLANGCI_LINT_IMAGE=docker.io/golangci/golangci-lint:v2.15.0@sha256:fbfcfd12a6f8d7f1b97b3362ca80fc2a244d46863148c73cb88e7793af96c481
RUFF_IMAGE=ghcr.io/astral-sh/ruff:0.17.2@sha256:d69a8c8d529a866a6aaea0dfda672693d68671a08827db765514abc1571a78a0
