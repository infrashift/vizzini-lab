# Pinned sources for the four tools under test. build.sh clones each SRC at
# its SHA into .cache/src/<tool>, so the working checkouts are never touched.
# SRC may be a local path (relative to this repo) or a git URL.

VIZZINI_SRC=../vizzini-pr-reviewer
# 9462f55: vizzini-bot CI templates (deploy/ci), pinned to mrman v0.1.5.
VIZZINI_SHA=9462f5588148ea4e06d8440b88bfaaf564997e79

MRMAN_SRC=../mrman
# v0.1.5: names the missing ADO permission on a 403 (mrman PR #15).
MRMAN_SHA=v0.1.5

GARMR_SRC=../garmr-policy-agent
GARMR_SHA=bf96753b9123fc9ac667afed84eba1610d896c53

OKFW_SRC=../okf-wiki
OKFW_SHA=557c304ed5616f4d633013697328f8d7980fc389

# LiteLLM proxy image, pinned by tag and digest (v1.99.4, built 2026-09-25).
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.99.4@sha256:475f4ae80a09d769d84c92202e70502abe52a62a760c97e598261c9c8cf8244f

# .NET SDK image for Roslyn SARIF.
DOTNET_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0

# Models under test, as named in litellm/config.yaml.
MODELS="claude-sonnet-5-5 claude-opus-5-5"

# Node image for ESLint (TypeScript fixtures): 24.22.1 (2026-10-21), by digest.
NODE_IMAGE=docker.io/library/node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53

# Seeded fixtures under fixtures/, each run through every model.
FIXTURES="csharp-seeded ts-seeded"

# Postgres for LiteLLM's spend logs (ISSUE-025): 17.10 (2026-07-07), by digest.
POSTGRES_IMAGE=docker.io/library/postgres:17.10-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
